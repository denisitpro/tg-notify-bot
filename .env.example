# === Telegram (required) ===
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric chat id (user or group). Get it by messaging @userinfobot.
TELEGRAM_CHAT_ID=

# === Polling ===
# How often to poll Solana RPC, in milliseconds (default 60000 = 1 minute)
POLL_INTERVAL_MS=60000

# === RPC endpoints ===
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# === Watch targets ===
# Treasury (native SOL) — one var per cluster. Uses getBalance (lamports).
WATCH_DEVNET_TREASURY_ADDRESS=
WATCH_MAINNET_TREASURY_ADDRESS=

# Fee revenue TOKEN accounts.
# These are SPL token accounts (ATA). Each token mint has its *own* ATA address.
#
# ONE list variable per cluster. Format: addr1:SYMBOL1,addr2:SYMBOL2
# Examples:
#   WATCH_DEVNET_FEE_TOKENS=3Sfkkg8jD1otcwcoJGHy5SjzHbBr3u9QjQB84AZNt5rr:USDC
#   WATCH_MAINNET_FEE_TOKENS=UsdcAta:USDC,UsdtAta:USDT
#
# Add any token without introducing new env vars.
WATCH_DEVNET_FEE_TOKENS=
WATCH_MAINNET_FEE_TOKENS=
